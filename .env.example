# Configuration for LLM APIs
# Copy this file to .env and fill in your actual API keys

# Google Gemini API Key (Get free from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (Optional, free LLaMA 3 inference: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
